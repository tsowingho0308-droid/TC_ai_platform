# Database
DATABASE_URL="postgresql://combine_ai:combine_ai_dev@localhost:5432/combine_ai_platform"

# Auth
JWT_SECRET="change-me-in-production"
SESSION_SECRET="change-me-in-production"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
SESSION_COOKIE_NAME="combine_ai_session"

# Google OAuth — see docs/GOOGLE-OAUTH-SETUP.md for full setup guide
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/email/integrations?action=callback"
GOOGLE_OAUTH_STATE_SECRET="change-me"
# Optional: workspace for auto-provisioned Google login users (defaults to demo-workspace)
# GOOGLE_LOGIN_WORKSPACE_ID="demo-workspace"
# GOOGLE_LOGIN_ACCOUNT_ID="demo-account"

# AI Provider — Alibaba Cloud Model Studio (百炼)
# Hong Kong acceleration node (recommended for regional compliance)
DASHSCOPE_BASE_URL="https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY=""
# Default model, can be overridden per-agent in UI:
#   Complex reasoning (Finance/Tender): qwen3.7-max, deepseek-v4-pro
#   General QA / reports (Helpdesk/Report): qwen3.6-plus
#   Fast classification (Email triage): qwen-flash
DASHSCOPE_DEFAULT_MODEL="qwen3.6-plus"

# Legacy AI Provider (kept for backward compatibility)
LLM_API_URL="https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY=""
LLM_MODEL="qwen3.6-plus"

# Embeddings
EMBEDDING_API_URL="https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSIONS=1536

# CORS
ALLOWED_CORS_ORIGINS="http://localhost:3000"
